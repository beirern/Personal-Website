---
// FlightLogbookLink component for linking to flight logbook
---

<a href="https://beirern.github.io/flight-logbook/index.html" class="flight-logbook-link" aria-label="Flight Logbook" target="_blank" rel="noopener noreferrer">
  <svg class="plane-icon" viewBox="0 0 24 24" width="20" height="20">
    <path fill="currentColor" d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/>
  </svg>
</a>

<style>
  .flight-logbook-link {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-hover);
    color: var(--color-text);
    width: 40px;
    height: 40px;
    text-decoration: none;
  }

  .flight-logbook-link:hover {
    background-color: var(--color-bg-secondary);
    border-color: var(--color-accent);
  }

  .flight-logbook-link:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .plane-icon {
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
</style>
